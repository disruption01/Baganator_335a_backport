<Ui>
  <Frame name="BaganatorItemViewCommonBankViewWarbandViewTemplate" virtual="true">
    <Scripts>
      <OnLoad>
        if self:GetName() then self['Money'] = _G[self:GetName() .. 'Money'] end
        if self:GetName() then self['BankMissingHint'] = _G[self:GetName() .. 'BankMissingHint'] end
        Mixin(self, BaganatorItemViewCommonBankViewWarbandViewMixin)
        if self.OnLoad then self:OnLoad() end
      </OnLoad>
      <OnShow>
        self:OnShow()
      </OnShow>
    </Scripts>
    <Frames>
      <Button inherits="UIPanelButtonTemplate" text="BAGANATOR_L_DEPOSIT_WARBOUND" name="$parentDepositItemsButton">
        <Scripts>
          <OnLoad>
        Baganator335Compat.ParentKey(self, 'DepositItemsButton', 'LiveButtons')
      </OnLoad><OnClick>
            C_Bank.AutoDepositItemsIntoBank(Enum.BankType.Account)
          </OnClick>
        </Scripts>
        <Anchors>
          <Anchor point="BOTTOM" y="29" />
        </Anchors>
      </Button>

      <CheckButton inherits="UICheckButtonTemplate" text="BAGANATOR_L_INCLUDE_REAGENTS" name="$parentIncludeReagentsCheckbox">
        <Size x="23" y="22" />
        <Scripts>
          <OnLoad>
        self['fontObject'] = _G['GameFontHighlight']
        Mixin(self, BankPanelIncludeReagentsCheckboxMixin)
        Baganator335Compat.ParentKey(self, 'IncludeReagentsCheckbox', 'LiveButtons')
        self.Text:SetText(self:GetText())
            self.Text:SetScript("OnMouseUp", function() self:Click() end)
      </OnLoad>
          <OnShow>
        self:OnShow()
      </OnShow>
          <OnClick>
        self:OnClick(button, down)
      </OnClick>
        </Scripts>
        <Anchors>
          <Anchor point="BOTTOM" y="6" />
        </Anchors>
      </CheckButton>

      <Button inherits="UIPanelButtonTemplate" text="DEPOSIT" name="$parentDepositMoneyButton">
        <Scripts>
          <OnLoad>
        Baganator335Compat.ParentKey(self, 'DepositMoneyButton', 'LiveButtons')
      </OnLoad><OnClick>
            self:GetParent():DepositMoney()
          </OnClick>
        </Scripts>
        <Anchors>
          <Anchor point="BOTTOM" y="29" />
        </Anchors>
      </Button>
      <Button inherits="UIPanelButtonTemplate" text="WITHDRAW" name="$parentWithdrawMoneyButton">
        <Scripts>
          <OnLoad>
        Baganator335Compat.ParentKey(self, 'WithdrawMoneyButton', 'LiveButtons')
      </OnLoad><OnClick>
            self:GetParent():WithdrawMoney()
          </OnClick>
        </Scripts>
        <Anchors>
          <Anchor point="RIGHT" relativePoint="LEFT" relativeTo="$parentDepositMoneyButton" />
        </Anchors>
      </Button>

      <Frame clampedToScreen="true" hidden="true" name="$parentTabSettingsMenu">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="40" y="5" relativeTo="$parent" />
        </Anchors>
      <Scripts><OnLoad>
        Baganator335Compat.ParentKey(self, 'TabSettingsMenu')
      </OnLoad></Scripts></Frame>
    </Frames>
    <Layers>
      <Layer level="BACKGROUND">
        <FontString inherits="GameFontHighlight" text="BAGANATOR_L_BANK_DATA_MISSING_HINT" name="$parentBankMissingHint">
          <Anchors>
            <Anchor point="LEFT" x="20" />
          </Anchors>
        </FontString>
        <FontString inherits="GameFontHighlight" enableMouse="true" name="$parentMoney">
          <Anchors>
            <Anchor point="BOTTOMRIGHT" x="-10" y="10" />
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
</Ui>